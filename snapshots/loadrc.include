# 从 loadrc 导出到快照的路径（白名单）。写法见 local/snapshot.sh 开头：
#   一行一个路径前缀，不支持通配符；! 开头是排除；@ 开头是把一个匿名拉不到的子模块整个并进来。
# 原则：只导目标机用得上的。漏导 = 目标机少个功能（看得见、能补）；多导 = 泄露（收不回）。
# 密钥检查工具查不出明文口令和内网地址这类东西，所以 bashrc / vishrc / agentrc / iterm2rc
# 这些「什么都往里放」的目录一律逐个文件写，不整目录导。
# 每一项为什么要、怎么增补，见 docs/decisions/loadrc-module.md。

# ---- shell：目标机的 ~/.zshrc 由 modules/20-loadrc/zshrc 提供，只加载下面这几个 rc ----
.pathrc
.envrc
.gitrc
.shellrc
.macosrc
.gorc
oh-my-zsh

# ---- tmux ----
.tmux.conf
.tmux/plugins/tpm
tmuxrc

# ---- vim / nvim ----
vimrc
!vimrc/tests
@vimrc/.vim/bundle/vim-anyfold
@vimrc/.vim/bundle/vim-autoformat
neovim/init.lua
neovim/.config/nvim/lua
update_project

# ---- git：全局配置、钩子、别名用到的脚本 ----
gitrc
!gitrc/gbil.log
.git-templates

