# 由 mac_setup 的 20-loadrc 模块放到 ~/.zshrc（别人电脑上用的版本）。
#
# 与参考机 ~/loadrc/.zshrc 的效果一致，只去掉不该在别人电脑上发生的事：
#   - 不加载 ~/loadrc/.loadrc 整条链，只逐个加载快照里带过来的 rc（.loadrc 末尾会在每开一个
#     shell 时重装 crontab、按主机名执行带 sudo 的命令、加载含凭证的文件）；
#   - 不自动起 ssh-agent、不把这台机器上的私钥加进 agent；
#   - 命令历史单独记一份，不写进机主的 ~/.zsh_history；补全缓存放进 ~/loadrc 里，不落在家目录。
# 依据见 mac_setup 仓库 docs/decisions/loadrc-module.md。

if [ -n "$MOSH_CONNECTION" ]; then
    unset DISPLAY
fi

# ---- oh-my-zsh（设置同参考机） ----
export ZSH=$HOME/.oh-my-zsh
ZSH_THEME="robbyrussell"
DISABLE_AUTO_UPDATE="true"
plugins=(git git-flow brew history node npm kubectl helm vagrant golang docker docker-compose)
ZSH_DISABLE_COMPFIX=true
HISTFILE="$HOME/.zsh_history_mac_setup"
ZSH_COMPDUMP="$HOME/loadrc/.zcompdump"
[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# ---- loadrc 的 rc：只加载快照里有的 ----
for _ms_rc in .pathrc .envrc .gitrc .shellrc .macosrc .gorc; do
    [ -f "$HOME/loadrc/$_ms_rc" ] && . "$HOME/loadrc/$_ms_rc"
done
unset _ms_rc

setopt HIST_IGNORE_ALL_DUPS

export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"

# Claude Code 会话接续：ccont 看全部状态，ccont --set <窗口> <会话> 手动指定
ccont() {
  case " $* " in
    *" --set "*) python3 "$HOME/loadrc/clauderc/claude_continue.py" "$@" ;;
    *) python3 "$HOME/loadrc/clauderc/claude_session_analyzer.py" --all ;;
  esac
}

export PATH=$HOME/bin:$PATH

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
[ -s "$NVM_DIR/nvm.sh" ] && nvm use default --delete-prefix --silent 2>/dev/null

# ---- 长任务完成通知：命令跑满阈值后响铃 + iTerm2 系统通知 ----
typeset -g LONG_TASK_THRESHOLD_SEC=180
zmodload zsh/datetime 2>/dev/null
_notify_long_task_preexec() { _cmd_start_ts=$EPOCHSECONDS }
_notify_long_task_precmd() {
  if [[ -n "$_cmd_start_ts" ]]; then
    local elapsed=$((EPOCHSECONDS - _cmd_start_ts))
    if (( elapsed >= LONG_TASK_THRESHOLD_SEC )); then
      printf '\a'
      printf '\e]9;Long task done in %ds\a' "$elapsed"
    fi
    unset _cmd_start_ts
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook preexec _notify_long_task_preexec
add-zsh-hook precmd _notify_long_task_precmd

notify_done() {
  local msg="${1:-Task done}"
  printf '\a'
  printf '\e]9;%s\a' "$msg"
}
